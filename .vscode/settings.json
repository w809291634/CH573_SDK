{
    "search.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/*.map": true,
        "**/*.htm": true,
        "**/*.asm": true,
        "**/*.i": true,
        "solutions/app_example": true,
        // "solutions/DK36L_3pwm_light": true,
    },
    // "files.exclude": {
    //     "**/.git": true,
    //     "**/.svn": true,
    //     "**/*.map": true,
    //     "**/*.htm": true,
    //     "**/*.asm": true,
    //     "**/*.i": true,
    // },
    "files.associations": {
        "*.i": "plaintext",
        "usb_hal_pcd.h": "c",
        "usb_usr_cfg.h": "c",
    },
    "editor.renderControlCharacters": true,                 //  显示空格 
    "editor.renderWhitespace": "all",
    "editor.tabSize": 4,
    "editor.detectIndentation":false,

    // git 管理
    "git.autoRepositoryDetection": true,
    "git.repositoryScanMaxDepth": 3,

    // gbk 编码
    // "files.encoding": "gbk",
    "files.autoGuessEncoding": true,

    // 设置水平滑块宽度
    "workbench.editor.titleScrollbarSizing": "large",

    // 开启显式折叠
    "explicitFolding.debug": false,
    "explicitFolding.rules": {
        "c,cpp": [
            {
                "beginRegex": "^\\s*#\\s*if(?:n?def)?\\b",
                "middleRegex": "^\\s*#\\s*el(?:se|if)\\b",
                "endRegex": "^\\s*#\\s*endif\\b"
            }
        ]
    },

    // 开启内联提示 按下ctrl + alt 显示
    "editor.inlayHints.enabled": "offUnlessPressed",
}